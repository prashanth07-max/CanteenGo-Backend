# CanteenGO Backend - Environment Variables Template
# Copy this file to .env (do not commit .env to git) or configure these in your PaaS hosting provider.

# Server Port (PaaS hosts like Render/Railway inject PORT automatically; default is 8080)
PORT=8080

# Database Connection URL
# For local development with MySQL:
# DB_URL=jdbc:mysql://localhost:3306/canteengo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# For managed / cloud MySQL (e.g. AWS RDS, Aiven, PlanetScale): TLS is required, add sslMode=REQUIRED
# DB_URL=jdbc:mysql://<host>:<port>/<database>?createDatabaseIfNotExist=true&sslMode=REQUIRED&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/canteengo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Database Credentials
DB_USER=root
DB_PASSWORD=root

# CORS Allowed Origins (comma-separated list of frontend URLs without trailing slash)
# In development: http://localhost:5173,http://localhost:3000
# In production: add your deployed frontend domain (e.g., https://canteengo.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Initial Admin Bootstrap
# Used only when starting against a fresh/empty database where no ADMIN exists yet.
# Once created, existing admins are never modified or reset on restart.
# Blank credentials on a fresh database will cause startup to fail fast to prevent insecure defaults.
ADMIN_EMAIL=admin@canteengo.com
ADMIN_PASSWORD=change_this_admin_password
